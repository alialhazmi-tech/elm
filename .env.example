# انسخ إلى .env.local واملأ القيم — لا تضع أسرارًا في هذا الملف
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
AUTH_SECRET=GENERATE_WITH_openssl_rand_-hex_32
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
# OpenRouter: اضبط المفتاح الحقيقي في أسرار التشغيل فقط.
# عند وجوده يُستخدم تلقائيًا؛ AI_PROVIDER يثبت الاختيار صراحةً عند الحاجة.
OPENROUTER_API_KEY=
AI_PROVIDER=
# اختياري: معرفات OpenRouter الكاملة، وإلا تُستخدم نظائر النماذج الحالية.
OPENROUTER_MODEL_EDITORIAL=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_LIGHT=
OPENROUTER_MODEL_IMAGE=
AWS_ENDPOINT_URL=https://t3.storageapi.dev
AWS_DEFAULT_REGION=auto
AWS_S3_BUCKET_NAME=project-bucket
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key

# ترحيلات المخطط من بيئة تشغيل منفصلة، باتصال مباشر (لا pooled)
DATABASE_URL_UNPOOLED=
# جدولة خارجية: POST /api/tahrir/tick؛ قيمة مستقلة عشوائية
CRON_SECRET=
SCHEDULER_ORIGIN=
# مفتاح AES-256 لتشفير MFA: 64 محرف hex، يُحفظ في مدير الأسرار مع نسخة استرداد
TAHRIR_MFA_KEY=
# إلزام التحقق بخطوتين لحسابات الإدارة — معطّل افتراضيًا؛ اضبطه 1 مع مفتاح MFA عند القرار.
TAHRIR_MFA_ENFORCE=

# النطاق العام بعد النقل. اضبطهما في بيئة production قبل إعادة البناء والنشر.
# SHARING_ORIGIN لروابط ومعاينات المشاركة؛ NEXT_PUBLIC_SITE_URL احتياطي وروابط الجوّال.
# الافتراضي في الكود https://alelm.net؛ نطاق معاينة مختلف يحتاج SHARING_ORIGIN صريحًا.
# لا تعدّل RAILWAY_PUBLIC_DOMAIN التلقائي، وهذه القيم لا تغيّر DNS.
SHARING_ORIGIN=https://alelm.net
NEXT_PUBLIC_SITE_URL=https://alelm.net

# رسائل العضوية العربية: تُفعّل بعد توثيق alelm.net في Resend ونشر webhook.
# لا تفعّل اشتراك Neon في send.otp/send.magic_link قبل اختبار التسليم.
ACCOUNT_EMAIL_ENABLED=false
RESEND_API_KEY=
# سر مستقل لا يقل عن 32 محرفًا لربط إشعار تغيير كلمة المرور بطلب الاستعادة.
ACCOUNT_EMAIL_RECEIPT_SECRET=
